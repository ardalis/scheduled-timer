{
  "name": "scheduled-timer",
  "version": "1.0.0",
  "private": true,
  "description": "A speaker tool that starts a configured countdown timer at a specific time.",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy",
    "test": "npm run test:unit && npm run test:e2e && npm run coverage",
    "test:unit": "c8 --temp-directory coverage/.v8/unit --reports-dir coverage/unit node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "coverage": "node scripts/coverage-report.js",
    "serve": "node tests/support/static-server.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "c8": "^12.0.0",
    "wrangler": "^4.0.0"
  },
  "license": "MIT"
}
